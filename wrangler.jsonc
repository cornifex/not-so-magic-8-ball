{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-so-magic-8-ball",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-30",
  // Served only on the custom domain: the Turnstile widget is tied to that
  // hostname, so a second workers.dev URL would just be a broken copy.
  "workers_dev": false,
  "routes": [
    { "pattern": "notsomagic8ball.com", "custom_domain": true },
    // Redirects to the bare domain (see src/worker/index.js).
    { "pattern": "www.notsomagic8ball.com", "custom_domain": true }
  ],
  // Public settings. Secrets (TYPESAFE_API_KEY, TURNSTILE_SECRET_KEY,
  // AI_GATEWAY_TOKEN, TYPESAFE_BASE_URL) are stored on the Worker, and
  // locally in .dev.vars, which also overrides these for development.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFKmJ9eNeM8tLLjU"
  },
  // The React app, built by Vite. The Cloudflare Vite plugin fills in the
  // assets directory. Any path that isn't a file serves index.html, so the
  // app's routes (/, /make) load directly. Everything except Vite's bundled
  // scripts and styles runs through the Worker first, so it can redirect www
  // to the bare domain and answer /api/*.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Per-visitor limit on /api/ask. Each answer takes a few seconds to
  // animate, so 10 a minute is well above a person's pace.
  "ratelimits": [
    {
      "name": "ASK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
